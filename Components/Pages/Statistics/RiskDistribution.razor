@page "/statistics/distribution"
@rendermode InteractiveServer
@inject AuthService Auth
@inject NavigationManager Nav
@inject StatisticsRepository StatRepo
@inject PatientRepository PatientRepo

<PageTitle>위험군 분포 — ChronicCare</PageTitle>

<h4 class="mb-4"><i class="bi bi-bar-chart-fill me-2"></i>위험군 분포 통계</h4>
<p class="text-muted">환자별 가장 최근 측정값을 기준으로 위험등급을 집계합니다.</p>

@if (_loading)
{
    <div class="d-flex justify-content-center py-5"><div class="spinner-border text-primary"></div></div>
}
else
{
    <div class="row g-3">
        <!-- 집계 카드 -->
        @foreach (var item in _data)
        {
            var bgClass = item.RiskLevel == "위험" ? "bg-danger" : item.RiskLevel == "주의" ? "bg-warning" : "bg-success";
            var pct = _total > 0 ? (double)item.Cnt / _total * 100 : 0;
            <div class="col-md-4">
                <div class="card text-white @bgClass shadow-sm @(item.RiskLevel == "주의" ? "text-dark" : "")">
                    <div class="card-body text-center">
                        <div class="display-5 fw-bold">@(item.Cnt)명</div>
                        <div class="fs-5">@item.RiskLevel</div>
                        <div>전체의 @pct.ToString("F1")%</div>
                    </div>
                </div>
            </div>
        }
        <!-- 미측정 -->
        @if (_noMeasure > 0)
        {
            <div class="col-md-4">
                <div class="card bg-secondary text-white shadow-sm">
                    <div class="card-body text-center">
                        <div class="display-5 fw-bold">@(_noMeasure)명</div>
                        <div class="fs-5">측정 없음</div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- 상세 테이블 -->
    <div class="card shadow-sm mt-4">
        <div class="card-header fw-semibold">위험군별 집계 상세</div>
        <div class="card-body p-0">
            <table class="table table-bordered mb-0">
                <thead class="table-dark text-center">
                    <tr><th>위험등급</th><th>환자 수</th><th>비율</th><th>시각화</th></tr>
                </thead>
                <tbody>
                    @foreach (var item in _data)
                    {
                        var barClass = item.RiskLevel == "위험" ? "bg-danger" : item.RiskLevel == "주의" ? "bg-warning" : "bg-success";
                        var pct = _total > 0 ? (int)((double)item.Cnt / _total * 100) : 0;
                        <tr>
                            <td class="text-center fw-semibold">
                                <span class="badge @barClass fs-6">@item.RiskLevel</span>
                            </td>
                            <td class="text-center fw-bold">@(item.Cnt)명</td>
                            <td class="text-center">@pct%</td>
                            <td>
                                <div class="progress" style="height:20px;">
                                    <div class="progress-bar @barClass fw-bold" style="width:@pct%">@pct%</div>
                                </div>
                            </td>
                        </tr>
                    }
                    <tr class="table-secondary">
                        <td class="text-center fw-bold">합계</td>
                        <td class="text-center fw-bold">@(_total)명</td>
                        <td class="text-center">100%</td>
                        <td></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- 위험군 환자 목록 -->
    @if (_dangerPatients.Count > 0)
    {
        <div class="card shadow-sm mt-4 border-danger">
            <div class="card-header fw-semibold text-danger">
                <i class="bi bi-exclamation-triangle-fill me-1"></i>위험 환자 목록 (즉시 모니터링 필요)
            </div>
            <div class="card-body p-0">
                <table class="table table-danger table-sm mb-0">
                    <thead><tr><th>환자명</th><th>질환</th><th>담당의</th><th>연령</th></tr></thead>
                    <tbody>
                        @foreach (var p in _dangerPatients)
                        {
                            <tr>
                                <td class="fw-semibold">@p.Name</td>
                                <td>@p.DiseaseType</td>
                                <td>@p.DoctorName</td>
                                <td>@(p.Age)세</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@code {
    private bool _loading = true;
    private List<RiskDistributionItem> _data = [];
    private int _total, _noMeasure;
    private List<PatientModel> _dangerPatients = [];

    protected override void OnInitialized()
    {
        if (!Auth.IsAuthenticated) Nav.NavigateTo("/login");
    }

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsAuthenticated) return;

        _data  = await StatRepo.GetRiskDistributionAsync();
        _total = _data.Sum(d => d.Cnt);

        var allPatients = await PatientRepo.GetAllAsync();
        _noMeasure = allPatients.Count - _total;

        // 위험 환자 목록 — 통계 결과와 매핑하기 위해 별도 쿼리 없이 환자 목록에서 가져옴
        // (실제로는 SP에서 환자명 포함 반환하는 것이 더 적합하지만, 학습용으로 간단하게 처리)
        _dangerPatients = allPatients.Take(
            _data.FirstOrDefault(d => d.RiskLevel == "위험")?.Cnt ?? 0
        ).ToList();

        _loading = false;
    }
}
