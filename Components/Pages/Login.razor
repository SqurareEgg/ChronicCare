@page "/login"
@rendermode InteractiveServer
@inject AuthService Auth
@inject NavigationManager Nav
@layout EmptyLayout

<PageTitle>로그인 — ChronicCare</PageTitle>

<div class="min-vh-100 d-flex align-items-center justify-content-center bg-light">
    <div class="card shadow" style="width: 380px;">
        <div class="card-header bg-primary text-white text-center py-4">
            <h4 class="mb-0"><i class="bi bi-heart-pulse-fill me-2"></i>ChronicCare</h4>
            <small>만성질환 모니터링 시스템</small>
        </div>
        <div class="card-body p-4">
            @if (!string.IsNullOrEmpty(_errorMsg))
            {
                <div class="alert alert-danger py-2">@_errorMsg</div>
            }
            <EditForm Model="_form" OnValidSubmit="HandleLogin" FormName="loginForm">
                <DataAnnotationsValidator />
                <div class="mb-3">
                    <label class="form-label fw-semibold">아이디</label>
                    <InputText class="form-control" @bind-Value="_form.LoginId" placeholder="아이디 입력" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">비밀번호</label>
                    <InputText type="password" class="form-control" @bind-Value="_form.Password" placeholder="비밀번호 입력" />
                </div>
                <button type="submit" class="btn btn-primary w-100" disabled="@_loading">
                    @if (_loading)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    }
                    로그인
                </button>
            </EditForm>
            <div class="mt-3 text-center text-muted small">
                테스트 계정: admin / 1234
            </div>
        </div>
    </div>
</div>

@code {
    private LoginForm _form = new();
    private string _errorMsg = "";
    private bool _loading = false;

    protected override void OnInitialized()
    {
        if (Auth.IsAuthenticated)
            Nav.NavigateTo("/");
    }

    private async Task HandleLogin()
    {
        _loading = true;
        _errorMsg = "";
        try
        {
            var ok = await Auth.LoginAsync(_form.LoginId, _form.Password);
            if (ok)
                Nav.NavigateTo("/");
            else
                _errorMsg = "아이디 또는 비밀번호가 올바르지 않습니다.";
        }
        catch (Exception ex)
        {
            _errorMsg = "DB 연결 오류: " + ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private class LoginForm
    {
        public string LoginId { get; set; } = "";
        public string Password { get; set; } = "";
    }
}
