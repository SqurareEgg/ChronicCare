@page "/measurements/create"
@rendermode InteractiveServer
@inject AuthService Auth
@inject NavigationManager Nav
@inject MeasurementRepository MeasRepo
@inject PatientRepository PatientRepo

<PageTitle>측정 등록 — ChronicCare</PageTitle>

<div class="d-flex align-items-center mb-3">
    <a href="/measurements" class="btn btn-sm btn-outline-secondary me-3"><i class="bi bi-arrow-left"></i></a>
    <h4 class="mb-0"><i class="bi bi-plus-circle-fill me-2"></i>측정 기록 등록</h4>
</div>

<div class="row g-3">
    <div class="col-md-7">
        <div class="card shadow-sm">
            <div class="card-header fw-semibold">측정값 입력</div>
            <div class="card-body">
                @if (!string.IsNullOrEmpty(_errorMsg))
                {
                    <div class="alert alert-danger">@_errorMsg</div>
                }
                <EditForm Model="_m" OnValidSubmit="HandleSubmit" FormName="measureCreateForm">
                    <DataAnnotationsValidator />
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label fw-semibold">환자 선택 <span class="text-danger">*</span></label>
                            <InputSelect class="form-select" @bind-Value="_m.PatientId">
                                <option value="0">— 환자 선택 —</option>
                                @foreach (var p in _patients)
                                {
                                    <option value="@p.PatientId">[@p.DiseaseType] @p.Name (@(p.Age)세, @(p.Gender == "M" ? "남" : "여"))</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">측정 유형</label>
                            <InputSelect class="form-select" @bind-Value="_m.MeasureType">
                                <option value="둘다">혈당 + 혈압</option>
                                <option value="혈당">혈당만</option>
                                <option value="혈압">혈압만</option>
                            </InputSelect>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">측정 일시</label>
                            <InputDate Type="InputDateType.DateTimeLocal" class="form-control" @bind-Value="_m.MeasureDate" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">혈당 (mg/dL)</label>
                            <input type="number" class="form-control"
                                   value="@_m.GlucoseLevel"
                                   @oninput="e => { _m.GlucoseLevel = ParseNullableInt(e.Value); RecalcRisk(); }"
                                   placeholder="정상: 70-99" />
                            <small class="text-muted">주의 ≥100 / 위험 ≥126</small>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">수축기 혈압</label>
                            <input type="number" class="form-control"
                                   value="@_m.SystolicBP"
                                   @oninput="e => { _m.SystolicBP = ParseNullableInt(e.Value); RecalcRisk(); }"
                                   placeholder="정상: <120" />
                            <small class="text-muted">주의 ≥120 / 위험 ≥140</small>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">이완기 혈압</label>
                            <input type="number" class="form-control"
                                   value="@_m.DiastolicBP"
                                   @oninput="e => { _m.DiastolicBP = ParseNullableInt(e.Value); RecalcRisk(); }"
                                   placeholder="정상: <80" />
                            <small class="text-muted">주의 ≥80 / 위험 ≥90</small>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">맥박 (bpm)</label>
                            <InputNumber class="form-control" @bind-Value="_m.HeartRate" placeholder="선택사항" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">특이사항</label>
                            <InputTextArea class="form-control" @bind-Value="_m.Note" rows="2" />
                        </div>
                    </div>
                    <div class="mt-4 d-flex gap-2">
                        <button type="submit" class="btn btn-primary" disabled="@_saving">
                            @if (_saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                            측정 저장
                        </button>
                        <a href="/measurements" class="btn btn-outline-secondary">취소</a>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>

    <!-- 실시간 위험도 표시 -->
    <div class="col-md-5">
        <div class="card shadow-sm @_riskCardClass">
            <div class="card-header fw-semibold">위험도 자동 계산 결과</div>
            <div class="card-body text-center py-4">
                <div class="display-4 fw-bold @_riskTextClass">@_m.RiskLevel</div>
                <div class="mt-2">
                    <span class="badge @RiskCalculator.RiskBadgeClass(_m.RiskLevel) fs-5">
                        위험점수: @(_m.RiskScore)점
                    </span>
                </div>
                <hr />
                <div class="text-start small">
                    <div class="d-flex justify-content-between">
                        <span>혈당 기여 점수</span>
                        <strong>@(_glucoseScore)점</strong>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span>수축기 기여 점수</span>
                        <strong>@(_systolicScore)점</strong>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span>이완기 기여 점수</span>
                        <strong>@(_diastolicScore)점</strong>
                    </div>
                </div>
                @if (_m.RiskLevel == "위험")
                {
                    <div class="alert alert-danger mt-3 mb-0 py-2">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        저장 시 <strong>알림이 자동 생성</strong>됩니다!
                    </div>
                }
            </div>
        </div>

        <!-- 위험도 기준표 -->
        <div class="card shadow-sm mt-3">
            <div class="card-header fw-semibold small">위험도 산정 기준</div>
            <div class="card-body p-2">
                <table class="table table-sm table-bordered mb-0 small">
                    <thead class="table-secondary text-center">
                        <tr><th>항목</th><th>정상(0점)</th><th>주의(+1점)</th><th>위험(+2점)</th></tr>
                    </thead>
                    <tbody class="text-center">
                        <tr><td>혈당</td><td>&lt;100</td><td>100~125</td><td>≥126</td></tr>
                        <tr><td>수축기</td><td>&lt;120</td><td>120~139</td><td>≥140</td></tr>
                        <tr><td>이완기</td><td>&lt;80</td><td>80~89</td><td>≥90</td></tr>
                    </tbody>
                </table>
                <div class="mt-2 small text-muted">합산 ≥4점: 위험 / 2~3점: 주의 / &lt;2점: 정상</div>
            </div>
        </div>
    </div>
</div>

@code {
    private MeasurementModel _m = new() { MeasureDate = DateTime.Now };
    private List<PatientModel> _patients = [];
    private string _errorMsg = "";
    private bool _saving = false;

    private int _glucoseScore, _systolicScore, _diastolicScore;
    private string _riskCardClass => _m.RiskLevel == "위험" ? "border-danger" : _m.RiskLevel == "주의" ? "border-warning" : "border-success";
    private string _riskTextClass => _m.RiskLevel == "위험" ? "text-danger" : _m.RiskLevel == "주의" ? "text-warning" : "text-success";

    protected override void OnInitialized()
    {
        if (!Auth.IsAuthenticated) Nav.NavigateTo("/login");
    }

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsAuthenticated) return;
        _patients = await PatientRepo.GetAllAsync();
    }

    private static int? ParseNullableInt(object? value)
    {
        return int.TryParse(value?.ToString(), out var n) ? n : null;
    }

    private void RecalcRisk()
    {
        var (score, level) = RiskCalculator.Calculate(_m.GlucoseLevel, _m.SystolicBP, _m.DiastolicBP);
        _m.RiskScore = score;
        _m.RiskLevel = level;

        _glucoseScore  = _m.GlucoseLevel.HasValue  ? (_m.GlucoseLevel  >= 126 ? 2 : _m.GlucoseLevel  >= 100 ? 1 : 0) : 0;
        _systolicScore = _m.SystolicBP.HasValue  ? (_m.SystolicBP  >= 140 ? 2 : _m.SystolicBP  >= 120 ? 1 : 0) : 0;
        _diastolicScore= _m.DiastolicBP.HasValue ? (_m.DiastolicBP >= 90  ? 2 : _m.DiastolicBP >= 80  ? 1 : 0) : 0;
    }

    private async Task HandleSubmit()
    {
        if (_m.PatientId == 0) { _errorMsg = "환자를 선택하세요."; return; }

        // 최종 위험도 계산
        var (score, level) = RiskCalculator.Calculate(_m.GlucoseLevel, _m.SystolicBP, _m.DiastolicBP);
        _m.RiskScore = score;
        _m.RiskLevel = level;
        _m.CreatedBy = Auth.CurrentUser!.UserId;

        _saving = true;
        try
        {
            await MeasRepo.InsertAsync(_m);
            Nav.NavigateTo("/measurements");
        }
        catch (Exception ex)
        {
            _errorMsg = "저장 실패: " + ex.Message;
            _saving = false;
        }
    }
}
